# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TRAVELPAYOUTS_API_TOKEN: Required for Travelpayouts Data API flight prices.
# Configure this via the Secrets panel in the AI Studio UI.
TRAVELPAYOUTS_API_TOKEN="MY_TRAVELPAYOUTS_API_TOKEN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Public URL of the backend service (e.g. Google Cloud Run) when frontend is deployed separately on Cloudflare Pages.
VITE_API_URL="https://araboair-backend.a.run.app"
